# Compliance Academy environment variables
# Copy this file to .env and populate. The .env file is gitignored.

# ----- Foundry project -----
# From Foundry portal > Project settings > Project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project-name

# ----- Model Router (for agents) -----
# Deployment name you chose when deploying model-router in Foundry
AZURE_AI_MODEL_ROUTER_DEPLOYMENT=compliance-academy-router

# ----- Direct model deployments (used by search service for agentic retrieval) -----
# Both deployed in your Foundry resource via Models + endpoints > Deploy model
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_CHAT_DEPLOYMENT=gpt-4.1-mini

# ----- Foundry IQ / Blob Storage -----
# Populated automatically by scripts/upload_foundry_iq.ps1 when run with -WriteEnvFile
FOUNDRY_IQ_STORAGE_ACCOUNT=
FOUNDRY_IQ_STORAGE_URL=
FOUNDRY_IQ_CONTAINER=foundry-iq-source
FOUNDRY_IQ_RESOURCE_GROUP=
FOUNDRY_IQ_LOCATION=eastus

# ----- Azure AI Search (the retrieval layer) -----
# From the search service you created in Section 4 of docs/foundry_setup.md
# The wizard in Section 6.3 creates the index with the prefix you specified (e.g. 'compliance')
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=compliance-content-index
AZURE_SEARCH_API_VERSION=2024-07-01
# Optional: admin key fallback. If your user account does not have the
# 'Search Index Data Reader' role on the search service, populate this
# with the primary or secondary admin key from
# Search service > Settings > Keys. DefaultAzureCredential is tried first;
# this key is used only if that fails. Leave blank for cleaner auth.
AZURE_SEARCH_ADMIN_KEY=

# ----- Optional: Claude model deployments (if Section 3 succeeded) -----
# AZURE_AI_CLAUDE_SONNET_DEPLOYMENT=claude-sonnet-4-5
# AZURE_AI_CLAUDE_HAIKU_DEPLOYMENT=claude-haiku-4-5
# AZURE_AI_CLAUDE_BASE_URL=https://your-foundry-resource.services.ai.azure.com/anthropic

